# Supabase project URL. Client + server. Public.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key. Client + server. Public by design: RLS is the boundary.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key (acts as service_role, skips RLS). Server only. Secret.
SUPABASE_SECRET_KEY=
# Clerk publishable key. Client. Public.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk secret key. Server. Secret.
CLERK_SECRET_KEY=
# OpenAI API key for the chat and embedding models. Server. Secret.
OPENAI_API_KEY=
# Signing secret to verify Clerk webhooks. Server. Secret.
CLERK_WEBHOOK_SIGNING_SECRET=
# Arcjet key for rate limiting and prompt injection checks. Server. Secret.
ARCJET_KEY=
# PostHog project key. Client + server. Public.
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog host URL. Client + server. Public.
NEXT_PUBLIC_POSTHOG_HOST=
# Base URL of the app (per environment). Client + server. Public.
NEXT_PUBLIC_APP_URL=
# Widget key of the landing page's own bot, read at request time. Server. A public key, but per-environment config.
LANDING_WIDGET_KEY=

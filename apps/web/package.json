{
  "name": "@askwell/web",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24.5.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @askwell/widget build && mkdir -p public && cp ../widget/dist/widget.js public/widget.js && next dev",
    "build": "pnpm --filter @askwell/widget build && mkdir -p public && cp ../widget/dist/widget.js public/widget.js && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern public/widget.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@arcjet/next": "^1.15.0",
    "@askwell/db": "workspace:*",
    "@askwell/shared": "workspace:*",
    "@clerk/nextjs": "^7.9.23",
    "@google/genai": "^2.32.0",
    "@posthog/ai": "^8.17.2",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.3",
    "posthog-js": "^1.444.0",
    "posthog-node": "^5.61.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@askwell/widget": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3"
  }
}

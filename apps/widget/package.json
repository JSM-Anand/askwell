{
  "name": "@askwell/widget",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p e2e/tsconfig.json",
    "test": "vitest run",
    "build": "esbuild src/index.ts --bundle --minify --format=iife --target=es2020 --outfile=dist/widget.js",
    "demo": "node demo/serve.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@askwell/shared": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "jsdom": "^30.1.3"
  }
}
